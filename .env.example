# Copia este archivo a .env y rellena con las credenciales de SOLO LECTURA del ERP.
# El .env NO se versiona (está en .gitignore) ni se copia a la imagen Docker.
SQLSERVER_HOST=<ip-o-host-del-sql-server>
SQLSERVER_DB=GOMEZYCRESPO
SQLSERVER_USER=<usuario_solo_lectura>
SQLSERVER_PASS=<password>

# PostgreSQL - replica analitica gyc_analytics (destino de los costes)
PG_HOST=10.0.0.12
PG_DB=gyc_analytics
PG_USER=gyc_etl
PG_PASS=
PG_PORT=5434

# Libro que lee Power Query, en la carpeta compartida.
#   Windows: M: Recursos tecnicos\IT\costes\datos_costes.xlsx
#   servidor Linux: /datos/datos_costes.xlsx (lo pone el compose)
# Si no se define o no se puede escribir, se avisa y se sigue: el dato
# ya esta en Postgres y se sirve por /costes/datos.xlsx
COSTES_SALIDA_XLSX=
